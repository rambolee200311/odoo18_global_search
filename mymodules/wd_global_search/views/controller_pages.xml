<odoo>
    <template id="global_search_workspace_page" name="Global Search Workspace">
        <![CDATA[<!doctype html>]]>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Global Search</title>
                <link rel="stylesheet" href="/wd_global_search/static/src/css/preview.css?v=cc017-v04"/>
            </head>
            <body>
                <main class="wd-workspace" data-testid="global-search-workspace"
                      t-att-data-config-version="config_version"
                      t-att-data-user-timezone="user_timezone">
                    <header class="wd-header">
                        <div>
                            <p class="wd-eyebrow">WD GLOBAL SEARCH</p>
                            <h1>Search Workspace</h1>
                        </div>
                        <span class="wd-readonly-badge" data-testid="readonly-badge">READ ONLY SEARCH</span>
                    </header>
                    <form class="wd-query-bar" aria-label="Search">
                        <label for="wd-query">Search query</label>
                        <input id="wd-query" data-testid="search-query" type="search"
                               placeholder="Search business records"/>
                        <button id="wd-search-submit" data-testid="search-submit" type="submit">Search</button>
                    </form>
                    <nav id="wd-resource-tabs" class="wd-resource-tabs"
                         aria-label="Business resources" hidden="hidden">
                        <t t-foreach="resources" t-as="resource">
                            <button class="wd-resource-tab"
                                    t-att-data-resource="resource['key']"
                                    t-att-data-states="resource['states_json']"
                                    t-att-data-searchable-fields="resource['searchable_fields_json']"
                                    t-att-data-testid="'resource-' + resource['key']"
                                    aria-pressed="false">
                                <span class="wd-resource-label"><t t-out="resource['label']"/></span>
                                <span class="wd-resource-count"
                                      t-att-data-count-for="resource['key']">—</span>
                            </button>
                        </t>
                    </nav>
                    <div class="wd-resource-empty" data-testid="resource-empty" hidden="hidden">
                        <p>Select at least one Resource to show results.</p>
                        <button id="wd-reselect-all" data-testid="reselect-all" type="button">
                            Reselect all accessible resources
                        </button>
                    </div>
                    <details class="wd-condition-builder" data-testid="condition-builder">
                        <summary class="wd-disclosure-summary">
                            <span role="heading" aria-level="2">Search by field</span>
                        </summary>
                        <div class="wd-condition-controls">
                            <label for="wd-condition-field">Field</label>
                            <select id="wd-condition-field" data-testid="condition-field">
                                <option value="">Choose an accessible field</option>
                            </select>
                            <label for="wd-condition-operator">Operator</label>
                            <select id="wd-condition-operator" data-testid="condition-operator" disabled="disabled">
                                <option value="">Choose an operator</option>
                            </select>
                            <label for="wd-condition-value">Value</label>
                            <div id="wd-condition-value-container" data-testid="condition-value-container">
                                <input id="wd-condition-value" data-testid="condition-value" disabled="disabled"/>
                            </div>
                            <button id="wd-condition-submit" data-testid="condition-submit"
                                    type="button" disabled="disabled">Add condition</button>
                            <button id="wd-remove-unavailable-conditions"
                                    data-testid="remove-unavailable-conditions" type="button" hidden="hidden">
                                Remove unavailable conditions
                            </button>
                            <p id="wd-condition-message" class="wd-condition-message" role="status"
                               data-testid="condition-message"></p>
                        </div>
                    </details>
                    <section class="wd-refinements" aria-label="Refinement">
                        <details class="wd-refinement-group" data-testid="refinement-group">
                            <summary data-testid="refinement-toggle">Date and state filters</summary>
                            <div class="wd-refinement-controls">
                                <label>Date preset <select id="wd-date-refinement" data-testid="date-refinement">
                                    <option value="">Any time</option>
                                    <option value="today">Today</option>
                                    <option value="this_week">This week</option>
                                    <option value="this_month">This month</option>
                                </select></label>
                                <label>From <input id="wd-date-start" data-testid="date-start" type="date"/></label>
                                <label>To (exclusive) <input id="wd-date-end" data-testid="date-end" type="date"/></label>
                                <p id="wd-date-message" class="wd-condition-message wd-date-message"
                                   role="alert" aria-live="assertive" hidden="hidden"></p>
                                <label>State <select id="wd-state-refinement" data-testid="state-refinement">
                                    <option value="">Any state</option>
                                </select></label>
                            </div>
                        </details>
                        <div id="wd-active-refinements" data-testid="active-refinements"></div>
                    </section>
                    <details class="wd-understanding" data-testid="query-understanding">
                        <summary class="wd-disclosure-summary">
                            <span role="heading" aria-level="2">Query Understanding</span>
                        </summary>
                        <div class="wd-understanding-content" aria-live="polite">
                            <div class="wd-condition-partition" data-testid="keyword-partition">
                                <h3>Keywords</h3>
                                <div id="wd-effective-keywords"></div>
                                <span id="wd-keyword-combinator"></span>
                                <div class="wd-keyword-add">
                                    <label for="wd-keyword-add">Add keyword</label>
                                    <input id="wd-keyword-add" data-testid="keyword-add" type="text"/>
                                    <button id="wd-keyword-add-submit" data-testid="keyword-add-submit"
                                            type="button">Add</button>
                                </div>
                            </div>
                            <div class="wd-condition-partition" data-testid="structured-partition">
                                <h3>Structured conditions</h3>
                                <div id="wd-effective-structured"></div>
                            </div>
                            <div class="wd-condition-partition" data-testid="refinement-partition">
                                <h3>Refinement</h3>
                                <div id="wd-effective-refinements"></div>
                            </div>
                            <p id="wd-condition-combination" class="wd-condition-combination">
                                Conditions from different sources follow existing rules; same-field alternatives
                                retain their existing OR semantics.
                            </p>
                            <span id="wd-effective-conditions" hidden="hidden"></span>
                        </div>
                    </details>
                    <section class="wd-layout">
                        <div class="wd-results" data-testid="results-pane">
                            <h2>Accessible records</h2>
                            <p class="wd-muted">Select a result; double-click to open its configured Odoo form.</p>
                            <div id="wd-result-list" data-testid="result-list"></div>
                            <div class="wd-pagination" data-testid="pagination" hidden="hidden">
                                <label>Rows per page
                                    <select id="wd-page-size" data-testid="page-size">
                                        <option value="10" selected="selected">10</option>
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                    </select>
                                </label>
                                <span id="wd-page-summary" class="wd-page-summary"
                                      data-testid="page-summary" aria-live="polite"></span>
                                <nav id="wd-page-controls" class="wd-page-controls"
                                     data-testid="page-controls" aria-label="Accessible records pages"></nav>
                            </div>
                        </div>
                    </section>
                </main>
                <script type="module" src="/wd_global_search/static/src/js/preview.js?v=cc018-phase4-v02"></script>
            </body>
        </html>
    </template>

    <template id="card_template_designer_page" name="Global Search Card Template Designer">
        <![CDATA[<!doctype html>]]>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Card Template — <t t-out="resource_name"/></title>
                <link rel="stylesheet" href="/wd_global_search/static/src/css/template_designer.css"/>
            </head>
            <body>
                <main class="wd-template-designer-page"
                      t-att-data-resource-id="resource_id"
                      t-att-data-csrf-token="csrf_token">
                    <header class="wd-template-header">
                        <div>
                            <p><button id="wd-template-back" class="btn btn-secondary" type="button">Back to Resource</button></p>
                            <h1>Card Template</h1>
                            <p class="wd-template-resource-name"><t t-out="resource_name"/></p>
                        </div>
                        <div class="wd-template-actions">
                            <button id="wd-template-check" class="btn btn-secondary" type="button">Check Template</button>
                            <button id="wd-template-save" class="btn btn-secondary" type="button">Save</button>
                            <button id="wd-template-apply" class="btn btn-primary" type="button" disabled="disabled">Apply Changes</button>
                        </div>
                    </header>
                    <p class="alert alert-warning" role="note">
                        Preview uses your current configuration account permissions; other users may see different fields or records.
                    </p>
                    <p id="wd-template-message" class="wd-template-message" role="status" aria-live="polite"></p>
                    <div class="wd-template-layout">
                        <label class="wd-template-editor">
                            <span>Template</span>
                            <textarea id="wd-template-input" maxlength="8192" spellcheck="false"></textarea>
                        </label>
                        <label class="wd-template-separator">
                            <span>Many2many value separator</span>
                            <input id="wd-template-separator" type="text"/>
                        </label>
                        <section class="wd-template-preview">
                            <h2>Live Preview</h2>
                            <label>
                                <span>Source</span>
                                <select id="wd-template-source">
                                    <option value="latest_readable_record">Latest readable record</option>
                                    <option value="selected_readable_record">Select a readable record</option>
                                    <option value="synthetic_example">Synthetic example</option>
                                </select>
                            </label>
                            <select id="wd-template-record" aria-label="Readable preview records" hidden="hidden"></select>
                            <pre id="wd-template-rendered" aria-live="polite"></pre>
                        </section>
                        <section class="wd-template-fields">
                            <h2>Available fields</h2>
                            <p>Drag a field into the template, or focus a field and press Enter to insert it.</p>
                            <p>Readability is for the preview user; group-restricted fields may not be visible to every search user.</p>
                            <ul id="wd-template-fields" class="wd-template-fields-list" role="listbox"></ul>
                        </section>
                    </div>
                </main>
                <script src="/wd_global_search/static/src/js/template_designer_page.js"></script>
            </body>
        </html>
    </template>

    <template id="navigation_error_page" name="Global Search Navigation Error">
        <![CDATA[<!doctype html>]]>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <title>Record unavailable</title>
            </head>
            <body>
                <main>
                    <p><t t-out="message"/></p>
                    <a href="/wd_global_search">Back to search</a>
                </main>
            </body>
        </html>
    </template>
</odoo>
