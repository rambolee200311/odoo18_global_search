<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
  <t t-name="tv_office_m2_owl.MappingCard">
    <div class="border rounded p-2 mt-2" data-testid="tv-m2-mapping-card">
      <strong>M2 Mapping Card Spike</strong>
      <label class="d-block mt-2" for="tv-m2-field-select">Candidate Odoo field</label>
      <select id="tv-m2-field-select" class="form-select" t-on-change="onChange">
        <option value="partner_id.name">Customer Name (partner_id.name)</option>
        <option value="amount_total">Total Amount (amount_total)</option>
        <option value="not.allowed">Invalid field (negative check)</option>
      </select>
      <button class="btn btn-primary btn-sm mt-2" t-on-click="submit">Submit selection</button>
      <span class="ms-2" data-testid="tv-m2-rpc-result" t-esc="state.status" />
    </div>
  </t>
  <t t-name="tv_office_m2_owl.MessageExtension" t-inherit="mail.Message" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o-mail-Message-content')]" position="inside">
      <!-- Test against the actual message model in the template scope. This keeps
           the Spike marker visible in the same scope used by mail.Message and
           avoids relying on a second component getter for the condition. -->
      <t t-if="message.model === 'llm.thread' and message.llm_role === 'user' and message.body and message.body.includes('TV-M2-CARD Owl render and RPC test marker')">
        <TVM2MappingCard />
      </t>
    </xpath>
  </t>
</templates>
